#!/bin/sh
# Pre-push hook: catches gofmt and test failures before pushing to CI.
# Install: git config core.hooksPath .githooks

set -e

echo "Running pre-push checks..."

# 1. gofmt check
UNFORMATTED=$(gofmt -l . 2>/dev/null | grep -v vendor || true)
if [ -n "$UNFORMATTED" ]; then
  echo ""
  echo "PUSH BLOCKED: gofmt formatting errors"
  echo ""
  echo "Unformatted files:"
  echo "$UNFORMATTED"
  echo ""
  echo "Fix with: gofmt -w \$(gofmt -l .)"
  exit 1
fi

# 2. golangci-lint (same linters as CI)
if command -v golangci-lint > /dev/null 2>&1; then
  echo "  golangci-lint..."
  LINT_OUTPUT=$(golangci-lint run --timeout=5m 2>&1) || LINT_EXIT=$?
  LINT_EXIT=${LINT_EXIT:-0}
  # If config is incompatible (v1 config with v2 binary), fall back to go vet
  if echo "$LINT_OUTPUT" | grep -q "unsupported version"; then
    echo "  golangci-lint config incompatible, falling back to go vet..."
    if ! go vet ./... 2>/dev/null; then
      echo ""
      echo "PUSH BLOCKED: go vet found issues"
      exit 1
    fi
  elif [ "$LINT_EXIT" -ne 0 ]; then
    echo "$LINT_OUTPUT"
    echo ""
    echo "PUSH BLOCKED: golangci-lint found issues"
    exit 1
  fi
else
  # Fallback to go vet if golangci-lint not installed
  echo "  go vet... (install golangci-lint for full CI parity)"
  if ! go vet ./... 2>/dev/null; then
    echo ""
    echo "PUSH BLOCKED: go vet found issues"
    exit 1
  fi
fi

# 3. go test (race detector)
echo "  go test -race..."
if ! go test -race ./... > /dev/null 2>&1; then
  echo ""
  echo "PUSH BLOCKED: tests failed"
  echo ""
  echo "Run 'go test -race ./...' to see details."
  exit 1
fi

echo "All pre-push checks passed."
