FROM golang:1.22-alpine AS builder

RUN apk add --no-cache git ca-certificates gcc musl-dev

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=1 GOOS=linux go build -ldflags="-s -w" -o /termiflow-api ./cmd/termiflow-api

# Runtime stage
FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata

COPY --from=builder /termiflow-api /usr/local/bin/termiflow-api

RUN adduser -D -h /app termiflow
USER termiflow
WORKDIR /app

RUN mkdir -p data

EXPOSE 8080

ENTRYPOINT ["termiflow-api"]
