# termiflow backend — copy to .env and fill in your values
# cp .env.example .env

# Required: Anthropic API key (used to proxy LLM requests)
TERMIFLOW_ANTHROPIC_API_KEY=sk-ant-...

# Required: Tavily API key (used to proxy search requests)
TERMIFLOW_TAVILY_API_KEY=tvly-...

# Required: Admin secret to issue/revoke tf_xxx API keys
TERMIFLOW_ADMIN_SECRET=change-me

# Optional: port to listen on (default: 8080)
PORT=8080

# Optional: SQLite database path (default: ./data/keys.db)
TERMIFLOW_DATABASE_PATH=./data/keys.db
